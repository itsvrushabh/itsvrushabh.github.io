# ==============================================================================
# .gitignore for itsvrushabh.github.io (Jekyll + Rust + Modern Web Portfolio)
# ==============================================================================

# Jekyll & Static Site Generation
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby & Bundler
.bundle/
vendor/bundle/
vendor/cache/
vendor/gems/
vendor/specifications/

# Rust Build Artifacts
target/
tools/portfolio-sync/target/
**/*.rs.bk

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configuration
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Scratch, Testing & Local Logs
scratch/
tmp/
*.log
.env
.env.local
.env.*.local

# Python Utilities & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/

# Raw Uncompressed Source Images (Only optimized WebP assets are tracked)
assets/images/*.png

